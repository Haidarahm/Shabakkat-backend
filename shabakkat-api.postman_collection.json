{
	"info": {
		"name": "Shabakkat API",
		"description": "API collection for the Shabakkat website backend (Laravel). Set the {{baseUrl}} variable to your server's base URL. All endpoints are prefixed with /api.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Health",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": {
					"raw": "{{baseUrl}}/api/health",
					"host": ["{{baseUrl}}"],
					"path": ["api", "health"]
				}
			}
		},
		{
			"name": "Projects",
			"item": [
				{
					"name": "List Projects",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/projects",
							"host": ["{{baseUrl}}"],
							"path": ["api", "projects"]
						}
					}
				},
				{
					"name": "Get Project by Slug",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/projects/:slug",
							"host": ["{{baseUrl}}"],
							"path": ["api", "projects", ":slug"],
							"variable": [
								{ "key": "slug", "value": "example-project-slug" }
							]
						}
					}
				},
				{
					"name": "Featured Projects",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/featured-projects",
							"host": ["{{baseUrl}}"],
							"path": ["api", "featured-projects"]
						}
					}
				}
			]
		},
		{
			"name": "Services",
			"item": [
				{
					"name": "Service Categories",
					"request": {
						"method": "GET",
