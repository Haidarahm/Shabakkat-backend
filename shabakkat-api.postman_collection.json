					"host": ["{{baseUrl}}"],
					"path": ["api", "faqs"]
				}
			}
		},
		{
			"name": "Submit Contact",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"John Doe\",\n    \"company\": \"Acme Inc\",\n    \"email\": \"john@example.com\",\n    \"phone\": \"+1234567890\",\n    \"service\": \"Consulting\",\n    \"message\": \"Hello, I'd like to learn more about your services.\"\n}",
					"options": {
						"raw": { "language": "json" }
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/contact",
					"host": ["{{baseUrl}}"],
					"path": ["api", "contact"]
				},
				"description": "Required fields: name, email, message. Optional: company, phone, service. A hidden 'website' honeypot field, if filled, returns {ok:true} without saving."
			}
		}
	]
}
